{% extends 'v3/final/base/scripts.html' %}

{% block main-content %}
    {% block browse-nav %}

<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/js/bootstrap.min.js"></script>

<nav class="navbar navbar-default">
            <div class="container-fluid">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                    <span class="sr-only">Toggle navigation</span>
                    </button>
                    <a class="navbar-brand" href="{% url 'home' %}">PDSquirrel</a>
                </div>
                <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <li><a href="{% url 'browse' %}">Browse PD</a></li>
                        {% if user.is_authenticated %}
			<li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">{{user.first_name}} {{user.last_name}}<span class="caret"></span></a>
			<ul class="dropdown-menu scrollbar-fix"  role = "menu">
                <li><a href="{% url 'dash' %}">My PD</a></li>
                <li><a href="{% url 'reports' %}">My Reports</a></li>
                <li><a href="{% url 'options' %}">My Account Options</a></li>
                <li><a href="{% url 'presenter-dash' %}">Presenter Hub</a></li>
				<li><a href="{% url 'logout' %}" onclick="return confirm('Are you sure?')">Sign Out</a></li>

					
			</ul>
			</li>
                        {% else %}
                        <li><a href="">Join</a></li>
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">Sign In <span class="caret"></span></a>
                            <ul class="dropdown-menu" role="menu" id="top-nav-ul">
                                <form class="form-horizontal" id="login-form" action = "{% url 'login' %}" method = "post">
                                    {% csrf_token %}
                                    <div class="row sign-in-row">
                                        <div class="col-xs-12">
                                            <h4 id='login-header-error' class = "bg-primary" id="login-msg"><b id = "login-msg"></b></h4>
                                        </div>
                                    </div>
                                    <div class="row sign-in-row">
                                        <div class="col-sm-10 col-sm-offset-1 col-xs-10 col-xs-offset-1">
                                            <div class="form-spacer">
                                                <input type="text" class="form-control" id="inputEmail3" name = "username" placeholder="Email">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row sign-in-row">
                                        <div class="col-sm-10 col-sm-offset-1 col-xs-10 col-xs-offset-1">
                                            <div class="form-spacer">
                                                <input type="password" class="form-control" name="password" placeholder="Password">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row sign-in-row">
                                        <div class="col-sm-10 col-sm-offset-1 col-xs-10 col-xs-offset-1">
                                            <div class="form-spacer">
                                                <button type="submit" id="login-button" class="btn btn-primary">Sign In</button>
						<a href = "" id = "forgot-pass-link">Forgot your password?</a>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <div class="row">
                                    <div class="col-xs-12">
                                        <hr class = "margin-top: 0px;">
                                    </div>
                                    <div class="col-sm-10 col-sm-offset-1 col-xs-10 col-xs-offset-1">
                                        <p id='login-link'>Don't have an account? <a class="" href = "{% url 'join' %}" >Join Today.</a></p>
                                    </div>
                                </div>
                            </ul>
                        </li>
                        {% endif %}
                    </ul>
                </div>
                <!-- /.navbar-collapse -->
            </div>
            <!-- /.container-fluid -->
        </nav>



    {% endblock browse-nav %}


{% block body %}
{% endblock body %}

{% block bottom-nav %}

<div class = "container-fluid navbar-bottom-container">
        <div class="navbar-bottom">
            <div class="row">
                <div class="col-xs-12 col-sm-offset-1">
                    <p style = "padding:20px;padding-bottom:0;padding-left:5px">&#169; PDSquirrel 2015</p>
                </div>
            </div>
            <div class="row bottom-logo">
                <div class="col-sm-10 col-sm-offset-1 col-xs-12">
                    <ul id="bottom-nav-links" class="list-inline">
                        {% block bottom-nav-links %}
                        <li><a href="{% url 'about' %}">About Us</a> &#8226; </li>
                        <li><a href="{% url 'contact-us' %}">Contact Us</a> &#8226; </li>
                        <li><a href="{% url 'terms' %}">Terms & Conditions</a> &#8226; </li>
                        <li><a href="{% url 'privacy' %}">Privacy</a> &#8226; </li>
                        <li><a href="{% url 'presenter-info' %}">Become a Presenter</a></li>
                        {% endblock bottom-nav-links %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock bottom-nav %}



{% endblock main-content %}


